# Supabase — used for sign-in only (app data lives in Cloudflare D1).
# Found in your project's Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# AI email import — server-only, never prefix these with NEXT_PUBLIC_
# Using Google Gemini via its OpenAI-compatible endpoint (has a free tier).
# Get a key at https://aistudio.google.com → "Get API key".
AI_PROXY_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-3.6-flash

# Any OpenAI-compatible provider also works, e.g.:
#   AI_PROXY_URL=https://api.openai.com/v1   AI_MODEL=gpt-4o-mini
