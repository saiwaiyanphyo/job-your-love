# Used by `wrangler` / `opennextjs-cloudflare preview` for local Worker runtime.
# Copy to `.dev.vars` and fill in real values.
# App data comes from the D1 binding in wrangler.jsonc; Supabase is sign-in only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# AI email import — server-only
# Google Gemini via its OpenAI-compatible endpoint (free tier).
# Get a key at https://aistudio.google.com → "Get API key".
AI_PROXY_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-3.6-flash
